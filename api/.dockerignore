# What never goes into the image. Secrets come from the environment at runtime, so no .env
# file of any kind is copied (that includes .env.testing.pgsql and the examples).
.env
.env.*

# Rebuilt inside the image.
vendor
node_modules
bootstrap/cache/*.php

# Local data and runtime leftovers.
database/*.sqlite
database/*.sqlite-journal
storage/logs/*
storage/pail
storage/*.key
storage/framework/cache/data/*
storage/framework/sessions/*
storage/framework/testing
storage/framework/views/*
public/hot
public/storage

# Not needed to run the app.
tests
phpunit.xml
phpstan.neon
.phpunit.result.cache
.phpunit.cache
Dockerfile
.dockerignore
.git
.github
.idea
.vscode
.editorconfig
*.md