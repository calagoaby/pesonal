# Every variable the Render web service needs. Placeholders only: the real values live in the
# Render dashboard (and PROXY_SECRET in Vercel's too). Never commit a filled-in copy.

APP_NAME=Pesonal
APP_ENV=production
# php artisan key:generate --show
APP_KEY=base64:replace-me
APP_DEBUG=false
# The public origin: the Vercel site, which proxies /api/* and /sanctum/* here. Social
# callback URLs are built from it.
APP_URL=https://your-app.vercel.app
FRONTEND_URL=https://your-app.vercel.app
SANCTUM_STATEFUL_DOMAINS=your-app.vercel.app

LOG_CHANNEL=stderr
LOG_LEVEL=info

# Neon Postgres. It sleeps after 5 idle minutes; only proxied requests reach the database.
DB_CONNECTION=pgsql
DB_URL=postgresql://user:password@your-neon-host/dbname
DB_SSLMODE=require

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Empty: a host-only cookie on the Vercel origin.
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=true

# Free plan: no Redis, no worker. Mail is sent inside the request; a refused send is logged.
CACHE_STORE=file
QUEUE_CONNECTION=sync

MAIL_MAILER=resend
RESEND_API_KEY=re_replace-me
# Without a verified domain Resend only sends from its own address, and only to the owner.
MAIL_FROM_ADDRESS=onboarding@resend.dev
MAIL_FROM_NAME="${APP_NAME}"

# Shared with the Vercel proxy, which sends it as X-Pesonal-Proxy. Without it every path but
# /up answers 404. openssl rand -hex 32
PROXY_SECRET=replace-me
# Standing orders are charged once a day at 00:05 in this timezone (the default).
JOB_TIMEZONE=Asia/Manila

ADMIN_EMAILS=owner@example.com

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=