includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 6
    paths:
        - app
    # PHP's default CLI memory_limit is 128M, and Larastan's multi-worker run
    # OOMs a worker there. One process helps, but a cold run still needs
    # `--memory-limit=512M` (fine for a 23-file app).
    parallel:
        maximumNumberOfProcesses: 1